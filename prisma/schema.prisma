generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection, used at runtime
  directUrl = env("DATABASE_URL_UNPOOLED") // direct connection, used for migrations
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // Validated as "ADMIN" | "TECHNICIAN" in application code (see src/lib/session.ts).
  role         String   @default("TECHNICIAN")
  // Forces a redirect to /change-password until cleared. New accounts start true;
  // accounts that existed before this column was added are backfilled to false in
  // the migration so current staff aren't interrupted (see migration.sql).
  mustChangePassword Boolean @default(true)
  createdAt    DateTime @default(now())

  foldersCreated Folder[]       @relation("FolderCreatedBy")
  filesUploaded  File[]         @relation("FileUploadedBy")
  activityLogs   ActivityLog[]  @relation("ActivityLogActor")
  favorites      Favorite[]
  groups         Group[]
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  parent    Folder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderChildren")
  files     File[]

  createdById String?
  createdBy   User?   @relation("FolderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  favoritedBy Favorite[]

  // Empty = visible to everyone (today's default). Non-empty restricts this folder
  // (and, by inheritance walked in src/lib/permissions.ts, its whole subtree) to
  // members of at least one of these groups. Files have no restriction of their own —
  // they inherit their folder's.
  restrictedByGroups Group[]

  tags Tag[]

  @@index([parentId])
}

model File {
  id               String   @id @default(cuid())
  displayName      String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  storagePath      String

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  favoritedBy Favorite[]

  tags Tag[]

  @@index([folderId])
}

model Favorite {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Exactly one of folderId/fileId is set — validated in application code
  // (see src/app/api/favorites/route.ts).
  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, folderId])
  @@unique([userId, fileId])
  @@index([userId])
}

model ActivityLog {
  id String @id @default(cuid())

  // e.g. "FOLDER_CREATE" | "FOLDER_RENAME" | "FOLDER_MOVE" | "FOLDER_DELETE"
  // | "FILE_UPLOAD" | "FILE_RENAME" | "FILE_MOVE" | "FILE_DELETE"
  // | "USER_CREATE" | "USER_DELETE" — validated in application code (see src/lib/activity-log.ts)
  action     String
  targetType String
  targetName String
  details    String?

  actorId String?
  actor   User?   @relation("ActivityLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Group {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  members            User[]
  restrictedFolders   Folder[]
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  folders Folder[]
  files   File[]
}
