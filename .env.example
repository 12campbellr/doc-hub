# Postgres (Neon, via the Vercel Marketplace) — auto-injected into the deployed
# project once connected. For local dev, copy the values from the Vercel
# dashboard into your local .env (both point at the same database).
DATABASE_URL="postgres://...?sslmode=require"
DATABASE_URL_UNPOOLED="postgres://..."

# Vercel Blob — auto-injected once a Blob store is created and connected to the project.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000" # set to the deployed URL in production

# Seed admin account (used once by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@dochub.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
