# Postgres — when provisioned via Vercel's Storage tab, these are auto-injected
# into the deployed project. For local dev, copy the values from the Vercel
# dashboard into your local .env (both point at the same database).
POSTGRES_PRISMA_URL="postgres://...?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgres://..."

# Vercel Blob — also auto-injected once a Blob store is created in the Storage tab.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000" # set to the deployed URL in production

# Seed admin account (used once by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@dochub.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
